+// ============ Currency/magnitude sanity check ============
+// Manual CSV price lists and the UBS quote export don't reliably agree on
+// which convention a price uses, and some currencies (JPY, KRW, IDR, HUF,
+// VND, ISK, CLP …) are conventionally quoted "per 100 units" by some
+// providers. Imported as-is, that silently produces a price ~100x too high
+// or too low. Rather than maintaining a per-source whitelist of who uses
+// which convention (fragile, drifts as sources change), every incoming
+// price is checked against the security's own last stored price: a genuine
+// single-import jump of ~100x (or ~1/100x) essentially never happens for
+// anything tracked here, so that specific jump is almost always a
+// quoting-convention or decimal mistake rather than a real market move.
+// Low-value currencies are surfaced only as a corroborating hint in the
+// warning text, never as a requirement for flagging — this also catches
+// plain fat-finger/decimal-shift errors on any currency.
+const LOW_VALUE_CCY = new Set(['JPY', 'KRW', 'IDR', 'HUF', 'VND', 'ISK', 'CLP']);
+
+let lastPriceCache = new Map(); // SecurityID -> { price:number, date:string(Swiss display) } | null
+async function ensureLastPrices(secIds) {
+  const missing = secIds.filter(id => !lastPriceCache.has(id));
+  if (!missing.length) return;
+  const placeholders = missing.map(() => '?').join(',');
+  const rows = await tursoQuery(
+    `SELECT SecurityID, Price, PriceDate FROM security_prices WHERE SecurityID IN (${placeholders})`,
+    missing
+  );
+  missing.forEach(id => lastPriceCache.set(id, null));
+  rows.forEach(r => {
+    if (r.Price === null || r.Price === undefined) return;
+    const dt = parseSwissDateTime(r.PriceDate);
+    if (!dt) return;
+    const cur = lastPriceCache.get(r.SecurityID);
+    if (!cur || dt > parseSwissDateTime(cur.date)) {
+      lastPriceCache.set(r.SecurityID, { price: Number(r.Price), date: toSwissDateTime(dt) });
+    }
+  });
+}
+
+// Returns null when nothing looks off (no price history yet, or the ratio to
+// the last price isn't near a x100/÷100 step). Tolerance band (40x–250x) is
+// deliberately wide of exactly 100x since real-world "per 100" feeds aren't
+// always a clean factor of exactly 100, but deliberately far from normal
+// day-to-day price moves (which are essentially never >10x for anything
+// this dashboard tracks) so it doesn't fire on genuine volatility.
+function checkMagnitude(secId, price, currency) {
+  const last = lastPriceCache.get(secId);
+  if (!last || !last.price || !price) return null;
+  const ratio = price / last.price;
+  if (!isFinite(ratio) || ratio <= 0) return null;
+  let factor = null;
+  if (ratio >= 40 && ratio <= 250) factor = 100;           // price looks ~100x too high
+  else if (ratio <= 1 / 40 && ratio >= 1 / 250) factor = 0.01; // price looks ~100x too low
+  if (!factor) return null;
+  return {
+    factor,
+    suggested: price / factor,
+    lastPrice: last.price,
+    lastDate: last.date,
+    lowValueCcy: LOW_VALUE_CCY.has((currency || '').toUpperCase().trim()),
+  };
+}
+function magnitudeLabel(mag) {
+  const dir = mag.factor === 100 ? '÷100' : '×100';
+  const hint = mag.lowValueCcy ? ' – Währung wird oft „je 100“ notiert' : '';
+  return `⚠ Kurssprung ~${mag.factor === 100 ? '100×' : '1/100×'} vs. letzter Kurs ${fmtDecimal(mag.lastPrice, 4)} (${mag.lastDate})${hint}. Vorschlag: ${dir} → ${fmtDecimal(mag.suggested, 4)}`;
+}
