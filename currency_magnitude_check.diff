+  const errCount = parsed.filter(p => rowStatus(p) === 'err').length;
+  const summary = `${parsed.length} rows parsed · <span class="good">${okCount()} ok</span>` +
+    (warnCount ? ` · <span class="bad">${warnCount} mit Kurssprung-Warnung (zu bestätigen)</span>` : '') +
+    (errCount ? ` · <span class="bad">${errCount} with errors (skipped on import)</span>` : '');
+
+  const rowsHtml = parsed.map((p, i) => {
+    const status = rowStatus(p);
+    const priceCell = (status === 'warn')
+      ? `${fmtDecimal(p.price, 4)}
+         <button type="button" class="mag-btn mag-fix" data-i="${i}">${p.magnitudeWarning.factor === 100 ? '÷100' : '×100'} → ${fmtDecimal(p.magnitudeWarning.suggested, 4)}</button>
+         <button type="button" class="mag-btn mag-accept" data-i="${i}">✓ so übernehmen</button>`
+      : (p.price ?? '—');
+    const cells = `<td>${p.secName ?? '—'}</td><td class="num">${priceCell}</td><td>${p.priceDate ?? '—'}</td><td>${p.source ?? '—'}</td>`;
+    const statusCell = {
+      err: `<td class="status-err">${p.errors.join('; ')}</td>`,
+      warn: `<td class="status-warn">${magnitudeLabel(p.magnitudeWarning)}</td>`,
+      ok: `<td class="status-ok">OK</td>`,
+    }[status];
+    return `<tr class="${status === 'err' ? 'row-error' : (status === 'warn' ? 'row-warn' : '')}">${cells}${statusCell}</tr>`;
+  }).join('');
+
+  area.innerHTML = `<div class="upload-box">
+    <div class="upload-summary">${summary}</div>
+    <div class="preview-table-wrap"><table class="preview-table">
+      <thead><tr><th>Security</th><th class="num">Price</th><th>PriceDate</th><th>Source</th><th>Status</th></tr></thead>
+      <tbody>${rowsHtml || '<tr><td colspan="99">No rows found.</td></tr>'}</tbody>
+    </table></div>
+    <div class="upload-actions">
+      <span class="quick-status" id="uploadStatus" style="align-self:center;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);"></span>
+      <button id="importBtn" ${okCount() ? '' : 'disabled'}>Import ${okCount()} row(s)</button>
+    </div>
+  </div>`;
+
+  area.querySelectorAll('.mag-fix').forEach(btn => {
+    btn.addEventListener('click', () => {
+      const p = parsed[Number(btn.dataset.i)];
+      p.price = p.magnitudeWarning.suggested;
+      p.magnitudeResolved = true;
+      renderPriceUploadPreview(area, parsed, onImport);
+    });
+  });
+  area.querySelectorAll('.mag-accept').forEach(btn => {
+    btn.addEventListener('click', () => {
+      const p = parsed[Number(btn.dataset.i)];
+      p.magnitudeResolved = true;
+      renderPriceUploadPreview(area, parsed, onImport);
+    });
+  });
+
+  const statusEl = area.querySelector('#uploadStatus');
+  area.querySelector('#importBtn').addEventListener('click', async (e) => {
+    e.target.disabled = true;
+    statusEl.textContent = 'Importing…';
+    try {
+      await onImport();
+      statusEl.textContent = 'Imported ✓ ' + nowZurichString();
+    } catch (err) {
+      statusEl.textContent = 'Error: ' + err.message;
+      e.target.disabled = false;
+    }
+  });
+}
