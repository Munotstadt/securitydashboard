+// accept/correct controls in the table.
+function renderPriceUploadPreview(area, parsed, onImport) {
+  const rowStatus = p => p.errors.length ? 'err' : (p.magnitudeWarning && !p.magnitudeResolved ? 'warn' : 'ok');
+  const okCount = () => parsed.filter(p => rowStatus(p) === 'ok').length;
