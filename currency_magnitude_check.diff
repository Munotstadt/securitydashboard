+// Recomputes the ~100x/1/100x price-magnitude check (see checkMagnitude
+// above) for every row that has a resolved SecurityID and a numeric price.
+// Resets any prior acknowledgment (magnitudeResolved) since the underlying
+// price or security assignment may have just changed (re-parse, dropdown
+// edit, manual price edit) and an old "confirmed" flag would otherwise
+// silently carry over to a different value.
+async function markUbsMagnitudeWarnings(parsed, master){
+  const secIds = [...new Set(parsed.filter(p => p.secId).map(p => p.secId))];
+  if (secIds.length) await ensureLastPrices(secIds);
+  parsed.forEach(p => {
+    p.magnitudeResolved = false;
+    if (!p.secId || p.price === null) { p.magnitudeWarning = null; return; }
+    const currency = (master.find(m => m.SecurityID === p.secId) || {}).Currency;
+    p.magnitudeWarning = checkMagnitude(p.secId, p.price, currency);
+  });
+}
